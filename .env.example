# ============================================================
# MeuCorre — Variáveis de Ambiente (TEMPLATE)
# ============================================================
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o .env no Git (já está no .gitignore).

# ===== Supabase (Postgres) =====
# Pegue em: https://supabase.com/dashboard/project/PROJECT_REF/settings/database
# Use a "Connection string" com Transaction Pooler (porta 6543)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ===== Supabase Storage (para upload de imagens — Release C) =====
# Pegue em: https://supabase.com/dashboard/project/PROJECT_REF/settings/api
# NEXT_PUBLIC_SUPABASE_URL = "Project URL" (público, pode expor no client)
# SUPABASE_SERVICE_ROLE_KEY = "service_role" secret (NUNCA expor no client — server-side only)
#
# IMPORTANTE: Crie um bucket público chamado "promotion-assets" em:
#   https://supabase.com/dashboard/project/PROJECT_REF/storage/buckets
#   - Public bucket: YES
#   - Allowed MIME types: image/png, image/jpeg, image/webp, image/gif
#   - File size limit: 10 MB
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ===== Admin =====
ADMIN_EMAIL="admin@meucorre.com"
ADMIN_PASSWORD="TroquePorUmaSenhaForte16chars"
# JWT secret pra assinar cookies de admin (gere com: openssl rand -hex 32)
ADMIN_JWT_SECRET="gere-com-openssl-rand-hex-32"

# ===== User auth =====
# JWT secret pra assinar cookies de usuários (gere com: openssl rand -hex 32)
USER_JWT_SECRET="gere-com-openssl-rand-hex-32"

# ===== Pix (fallback manual, se Kiwify indisponível) =====
PIX_KEY="seu-pix@email.com"
PIX_MERCHANT_NAME="MeuCorre"
PLAN_PRICE=18.90

# ===== Kiwify (pagamentos) =====
KIWIFY_PRODUCT_ID=""
KIWIFY_WEBHOOK_SECRET="seu_webhook_secret_da_kiwify"
# Slug do plano vitalício (pagamento único)
NEXT_PUBLIC_KIWIFY_PRODUCT_SLUG="bknZCSZ"
# Slug do plano mensal (assinatura recorrente)
NEXT_PUBLIC_KIWIFY_SLUG_MONTHLY="TfP70tb"
# Slug do plano anual (assinatura recorrente)
NEXT_PUBLIC_KIWIFY_SLUG_ANNUAL="H5FQHa4"
# Preços exibidos na landing page
MONTHLY_PRICE=14.9
ANNUAL_PRICE=97

# ===== Google AdSense =====
# Publisher ID (ca-pub-XXXXXXXXXXXXXXXX). Se vazio, anúncios não aparecem.
NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-1217313384915824"

# ===== Sentry (observabilidade — OBRIGATÓRIO em produção) =====
# Pegue em: https://sentry.io → Settings → Projects → MeuCorre → DSN
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ===== Vercel Cron (jobs automáticos) =====
# Secret para autenticar rotas cron. Configure em:
# Vercel Dashboard → Settings → Environment Variables → CRON_SECRET
# A Vercel envia automaticamente: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="gere-com-openssl-rand-hex-16"

# ===== Upstash Redis (rate limiting distribuído — OBRIGATÓRIO em produção) =====
# Pegue em: https://console.upstash.com → Create Database
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ===== Resend (envio de email — OBRIGATÓRIO para forgot-password) =====
# Pegue em: https://resend.com → API Keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="MeuCorre <noreply@meucorre.com>"

# ===== App URL =====
NEXT_PUBLIC_APP_URL="https://meucorre.vercel.app"

# ===== E2E Test Bypass (para testes Playwright não serem bloqueados por rate limit) =====
E2E_TEST_BYPASS_TOKEN="gere-com-openssl-rand-hex-32"

# ===== Cron Secret (para endpoints /api/cron/* — purge, cleanup, etc) =====
CRON_SECRET="gere-com-openssl-rand-hex-32"
