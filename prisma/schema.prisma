// Schema do MeuCorre — backend do admin (anúncios, planos, assinaturas).
// O app do entregador continua 100% Local-First (Dexie.js / IndexedDB).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===== Anúncios (admin cadastra, app do entregador exibe) =====

model Ad {
  id          String   @id @default(cuid())
  title       String
  description String?
  cta         String   @default("Saiba mais") // texto do botão
  url         String?  // link de destino
  imageUrl    String?  // URL da imagem do anúncio
  bgColor     String   @default("#10b981") // cor de fundo do card
  textColor   String   @default("#09090b")
  placement   String   @default("banner_top") // banner_top | card_list | splash
  active      Boolean  @default(true)
  startsAt    DateTime @default(now())
  endsAt      DateTime?
  clicks      Int      @default(0)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([placement, active])
}

// ===== Compras do plano vitalício (Pix manual OU Kiwify) =====

model Subscription {
  id           String   @id @default(cuid())
  // Identificação do comprador
  buyerName    String
  buyerEmail   String
  buyerPhone   String?
  buyerCity    String?
  // Pagamento
  pixKey       String   @default("meucorre@pix.com")
  amount       Decimal  @default(18.90) @db.Decimal(10, 2) // R$ — Decimal evita perda de precisão
  paymentMethod String  @default("pix_manual") // pix_manual | kiwify
  // Comprovante (apenas pix_manual)
  receiptUrl   String?
  receiptNotes String?
  // Kiwify (webhook auto-approve)
  kiwifyOrderId String? @unique // ID do pedido na Kiwify
  kiwifyChargeId String? // ID da cobrança na Kiwify
  // Status
  status       String   @default("pending") // pending | approved | rejected
  reviewedAt   DateTime?
  reviewedBy   String?
  reviewNotes  String?
  // Licença gerada quando aprovada
  licenseKey   String?  @unique // chave que libera o PRO no app
  deviceId     String?
  activatedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([buyerEmail])
  @@index([kiwifyOrderId])
}

// ===== Cliques/visualizações de anúncios (analytics) =====

model AdEvent {
  id        String   @id @default(cuid())
  adId      String
  eventType String   // view | click
  createdAt DateTime @default(now())

  @@index([adId, eventType])
}

// ===== Feedback dos usuários =====

model Feedback {
  id        String   @id @default(cuid())
  rating    Int      // 1-5 estrelas
  message   String
  userAgent String?
  page      String?  // em qual página estava (landing, app, etc.)
  createdAt DateTime @default(now())

  @@index([createdAt]) // ordenação por data sem table scan
  @@index([rating])    // filtro por nota
}

// ===== Usuários entregadores (auth) =====

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  isPro        Boolean  @default(false)
  licenseKey   String?  @unique
  phone        String?
  city         String?
  active       Boolean  @default(true) // admin pode desativar
  trialExtendedUntil DateTime? // admin pode estender trial
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([isPro])
  @@index([active])
}

// ===== Tokens de recuperação de senha =====

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ===== Sincronização entre dispositivos =====
// Corridas e despesas sincronizadas do IndexedDB local pro servidor
// quando o usuário está logado. Permite acessar dados em múltiplos dispositivos.

model SyncedDelivery {
  id          String   @id @default(cuid())
  userId      String
  localId     Int      // ID no IndexedDB do dispositivo de origem
  app         String
  value       Decimal  @db.Decimal(10, 2)
  km          Decimal  @db.Decimal(10, 2) @default(0)
  date        String   // YYYY-MM-DD
  timestamp   BigInt
  notes       String?
  updatedAt   BigInt   // epoch ms — last-write-wins
  deleted     Boolean  @default(false) // soft delete pra sync

  @@unique([userId, localId])
  @@index([userId, updatedAt])
  @@index([userId, date])
}

model SyncedExpense {
  id          String   @id @default(cuid())
  userId      String
  localId     Int
  category    String
  value       Decimal  @db.Decimal(10, 2)
  description String?
  date        String
  timestamp   BigInt
  updatedAt   BigInt
  deleted     Boolean  @default(false)

  @@unique([userId, localId])
  @@index([userId, updatedAt])
  @@index([userId, date])
}

// ===== Configurações globais (admin) =====

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  updatedAt DateTime @updatedAt
}

// ===== Contas de administrador (multi-admin) =====
//
// Antes: admin era hardcoded via env var ADMIN_EMAIL (single-user).
// Agora: suporta múltiplos admins com roles diferentes.
// Compatibilidade: se ADMIN_EMAIL estiver configurado e não existir na tabela,
// esse admin ainda funciona (fallback durante transição).

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("admin") // admin | super_admin
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([active])
}

// ===== Audit log de ações administrativas =====
//
// Registra quem fez o quê, quando, e em qual recurso.
// Essencial para rastreabilidade e compliance.

model AdminAction {
  id        String   @id @default(cuid())
  adminId   String   // ID do AdminUser (ou email se fallback)
  adminEmail String
  action    String   // create | update | delete | toggle_pro | etc.
  resource  String   // user | subscription | ad | feedback | etc.
  resourceId String? // ID do recurso afetado
  details   String?  // JSON com detalhes da ação
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([resource, createdAt])
}

// ===== Programa de Indicação (Referral Program) =====
//
// Sistema customizado de indicação onde usuários PRO ganham R$5 (PIX)
// por cada amigo que se torna PRO. Admin ativa/desativa a campanha e
// processa os pagamentos.

// Cada usuário PRO recebe um código de indicação único
model ReferralCode {
  id        String   @id @default(cuid())
  userId    String   @unique // dono do código
  code      String   @unique // ex: "MEUCORRE-ABC123"
  clicks    Int      @default(0) // quantas vezes o link foi clicado
  active    Boolean  @default(true)
  pixKey    String?  // chave PIX do referrer para receber recompensas
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([code])
}

// Registro de quem indicou quem (1 usuário só pode ser indicado por 1 pessoa)
model Referral {
  id            String    @id @default(cuid())
  referrerId    String    // quem indicou
  referrerCode  String    // código usado
  referredId    String    @unique // quem foi indicado
  referredEmail String
  referredName  String
  status        String    @default("pending") // pending | converted | paid | rejected
  convertedAt   DateTime? // quando o indicado virou PRO
  paidAt        DateTime? // quando admin pagou o PIX
  payoutAmount  Decimal   @default(5) @db.Decimal(10, 2)
  payoutPixKey  String?   // chave PIX do referrer (para pagamento)
  adminNotes    String?   // notas do admin
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([referrerId, status])
  @@index([referredId])
  @@index([status, createdAt])
}

// Configuração da campanha de indicação (ativa/desativa, valor, limites)
model ReferralCampaign {
  id           String    @id @default(cuid())
  name         String    @default("Indique e Ganhe")
  active       Boolean   @default(false) // admin liga/desliga
  rewardAmount Decimal   @default(5) @db.Decimal(10, 2)
  maxReferrals Int       @default(0) // 0 = ilimitado
  startsAt     DateTime?
  endsAt       DateTime?
  termsUrl     String?   // URL dos termos e condições
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
