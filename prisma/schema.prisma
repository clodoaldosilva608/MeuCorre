// Schema do MeuCorre — backend do admin (anúncios, planos, assinaturas).
// O app do entregador continua 100% Local-First (Dexie.js / IndexedDB).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===== Anúncios (admin cadastra, app do entregador exibe) =====

model Ad {
  id          String   @id @default(cuid())
  title       String
  description String?
  cta         String   @default("Saiba mais") // texto do botão
  url         String?  // link de destino
  imageUrl    String?  // URL da imagem do anúncio
  bgColor     String   @default("#10b981") // cor de fundo do card
  textColor   String   @default("#09090b")
  placement   String   @default("banner_top") // banner_top | card_list | splash
  active      Boolean  @default(true)
  startsAt    DateTime @default(now())
  endsAt      DateTime?
  clicks      Int      @default(0)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([placement, active])
}

// ===== Compras do plano vitalício (Pix manual OU Kiwify) =====

model Subscription {
  id           String   @id @default(cuid())
  // Identificação do comprador
  buyerName    String
  buyerEmail   String
  buyerPhone   String?
  buyerCity    String?
  // Pagamento
  pixKey       String   @default("meucorre@pix.com")
  amount       Decimal  @default(18.90) @db.Decimal(10, 2) // R$ — Decimal evita perda de precisão
  paymentMethod String  @default("pix_manual") // pix_manual | kiwify
  // Comprovante (apenas pix_manual)
  receiptUrl   String?
  receiptNotes String?
  // Kiwify (webhook auto-approve)
  kiwifyOrderId String? @unique // ID do pedido na Kiwify
  kiwifyChargeId String? // ID da cobrança na Kiwify
  // Status
  status       String   @default("pending") // pending | approved | rejected
  reviewedAt   DateTime?
  reviewedBy   String?
  reviewNotes  String?
  // Plano adquirido (Sub-fase 1): "monthly" | "annual" | "lifetime"
  plan         String?  // null = compatibilidade com registros antigos
  // Licença gerada quando aprovada
  licenseKey   String?  @unique // chave que libera o PRO no app
  deviceId     String?
  activatedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([buyerEmail])
  @@index([kiwifyOrderId])
  @@index([plan, status])
}

// ===== Cliques/visualizações de anúncios (analytics) =====

model AdEvent {
  id        String   @id @default(cuid())
  adId      String
  eventType String   // view | click
  createdAt DateTime @default(now())

  @@index([adId, eventType])
}

// ===== Feedback dos usuários =====

model Feedback {
  id        String   @id @default(cuid())
  rating    Int      // 1-5 estrelas
  message   String
  userAgent String?
  page      String?  // em qual página estava (landing, app, etc.)
  createdAt DateTime @default(now())

  @@index([createdAt]) // ordenação por data sem table scan
  @@index([rating])    // filtro por nota
}

// ===== Usuários entregadores (auth) =====

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  isPro        Boolean  @default(false)
  licenseKey   String?  @unique
  phone        String?
  city         String?
  active       Boolean  @default(true) // admin pode desativar
  trialExtendedUntil DateTime? // admin pode estender trial
  // ===== Sub-fase 1: plano de assinatura =====
  // Plano atual do usuário: monthly (R$14,90/mês), annual (R$97/ano), lifetime (R$18,90 vitalício)
  // null = ainda no trial/free. isPro=true indica acesso PRO ativo (vitalício ou assinatura não expirada).
  subscriptionPlan    String?  // "monthly" | "annual" | "lifetime"
  subscriptionStatus  String?  // "active" | "expired" | "cancelled" | "trialing"
  subscriptionExpiresAt DateTime? // null para lifetime
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([isPro])
  @@index([active])
  @@index([subscriptionStatus])
}

// ===== Loja — Ofertas de produtos parceiros (Sub-fase 1) =====
//
// Produtos com desconto cadastrados pelo admin (modelagem afiliado).
// O usuário vê os cards na aba "Ofertas" do dashboard e clica para
// ser redirecionado ao link do parceiro (com UTM tracking).
//
// Curadoria do admin: apenas produtos relevantes para entregadores
// (mochila térmica, capa de chuva, suporte, equipamentos, etc).

model Offer {
  id            String   @id @default(cuid())
  title         String
  description   String
  // Preço com desconto (ex: R$ 89,90)
  price         Decimal  @db.Decimal(10, 2)
  // Preço original (ex: R$ 149,90) — usado para calcular % desconto
  originalPrice Decimal? @db.Decimal(10, 2)
  // URL externa da imagem (hot-linked) OU data URL base64 (upload)
  imageUrl      String
  // URL de vídeo do produto (YouTube/Vimeo) — opcional
  videoUrl      String?
  // URL de afiliado do produto (Amazon, Mercado Livre, Shopee, etc)
  productUrl    String
  // Categoria para filtro: "equipamentos" | "combustivel" | "seguro" | "ferramentas" | "outros"
  category      String   @default("equipamentos")
  // Apenas usuários PRO veem essa oferta (upsell incentive)
  proOnly       Boolean  @default(false)
  active        Boolean  @default(true)
  startsAt      DateTime @default(now())
  endsAt        DateTime?
  clicks        Int      @default(0) // contador de cliques para analytics
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active, startsAt])
  @@index([category])
  @@index([proOnly])
}

// ===== Tokens de recuperação de senha =====

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ===== Metas financeiras do entregador (sync entre dispositivos) =====
model SyncedGoal {
  id          String   @id @default(cuid())
  userId      String
  localId     Int
  type        String   // "daily" | "weekly" | "monthly"
  targetValue Decimal  @db.Decimal(10, 2)
  label       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   BigInt
  deleted     Boolean  @default(false)

  @@unique([userId, localId])
  @@index([userId, updatedAt])
  @@index([userId, type, active])
}

// ===== Sessões de trabalho "Corre do dia" (sync entre dispositivos) =====
model SyncedWorkSession {
  id          String   @id @default(cuid())
  userId      String
  localId     Int
  startTime   BigInt
  endTime     BigInt?
  durationMs  BigInt   @default(0)
  distanceKm  Decimal  @db.Decimal(10, 2) @default(0)
  pointCount  Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   BigInt
  deleted     Boolean  @default(false)

  @@unique([userId, localId])
  @@index([userId, updatedAt])
  @@index([userId, startTime])
}

// ===== Sincronização entre dispositivos =====
// Corridas e despesas sincronizadas do IndexedDB local pro servidor
// quando o usuário está logado. Permite acessar dados em múltiplos dispositivos.

model SyncedDelivery {
  id          String   @id @default(cuid())
  userId      String
  localId     Int      // ID no IndexedDB do dispositivo de origem
  app         String
  value       Decimal  @db.Decimal(10, 2)
  km          Decimal  @db.Decimal(10, 2) @default(0)
  date        String   // YYYY-MM-DD
  timestamp   BigInt
  notes       String?
  updatedAt   BigInt   // epoch ms — last-write-wins
  deleted     Boolean  @default(false) // soft delete pra sync

  @@unique([userId, localId])
  @@index([userId, updatedAt])
  @@index([userId, date])
}

model SyncedExpense {
  id          String   @id @default(cuid())
  userId      String
  localId     Int
  category    String
  value       Decimal  @db.Decimal(10, 2)
  description String?
  date        String
  timestamp   BigInt
  updatedAt   BigInt
  deleted     Boolean  @default(false)

  @@unique([userId, localId])
  @@index([userId, updatedAt])
  @@index([userId, date])
}

// ===== Configurações globais (admin) =====

// ===== Blog — Posts internos (com opção de publicar no Blogger) =====

model BlogPost {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String
  content       String   // HTML completo
  coverUrl      String?  // URL da imagem de capa
  category      String   @default("dicas")
  labels        String?  // tags separadas por vírgula
  published     Boolean  @default(true)
  bloggerPostId String?  // ID no Blogger se foi publicado externamente
  bloggerUrl    String?  // URL no Blogger
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, createdAt])
  @@index([slug])
}

// ===== Configurações do app (Settings estendido) =====

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  updatedAt DateTime @updatedAt
}

// ===== Contas de administrador (multi-admin) =====
//
// Antes: admin era hardcoded via env var ADMIN_EMAIL (single-user).
// Agora: suporta múltiplos admins com roles diferentes.
// Compatibilidade: se ADMIN_EMAIL estiver configurado e não existir na tabela,
// esse admin ainda funciona (fallback durante transição).

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("admin") // admin | super_admin
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([active])
}

// ===== Audit log de ações administrativas =====
//
// Registra quem fez o quê, quando, e em qual recurso.
// Essencial para rastreabilidade e compliance.

model AdminAction {
  id        String   @id @default(cuid())
  adminId   String   // ID do AdminUser (ou email se fallback)
  adminEmail String
  action    String   // create | update | delete | toggle_pro | etc.
  resource  String   // user | subscription | ad | feedback | etc.
  resourceId String? // ID do recurso afetado
  details   String?  // JSON com detalhes da ação
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([resource, createdAt])
}

// ===== Programa de Indicação (Referral Program) =====
//
// Sistema customizado de indicação onde usuários PRO ganham R$5 (PIX)
// por cada amigo que se torna PRO. Admin ativa/desativa a campanha e
// processa os pagamentos.

// Cada usuário PRO recebe um código de indicação único
model ReferralCode {
  id        String   @id @default(cuid())
  userId    String   @unique // dono do código
  code      String   @unique // ex: "MEUCORRE-ABC123"
  clicks    Int      @default(0) // quantas vezes o link foi clicado
  active    Boolean  @default(true)
  pixKey    String?  // chave PIX do referrer para receber recompensas
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([code])
}

// Registro de quem indicou quem (1 usuário só pode ser indicado por 1 pessoa)
model Referral {
  id            String    @id @default(cuid())
  referrerId    String    // quem indicou
  referrerCode  String    // código usado
  referredId    String    @unique // quem foi indicado
  referredEmail String
  referredName  String
  status        String    @default("pending") // pending | converted | paid | rejected
  convertedAt   DateTime? // quando o indicado virou PRO
  paidAt        DateTime? // quando admin pagou o PIX
  payoutAmount  Decimal   @default(5) @db.Decimal(10, 2)
  payoutPixKey  String?   // chave PIX do referrer (para pagamento)
  adminNotes    String?   // notas do admin
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([referrerId, status])
  @@index([referredId])
  @@index([status, createdAt])
}

// Configuração da campanha de indicação (ativa/desativa, valor, limites)
model ReferralCampaign {
  id           String    @id @default(cuid())
  name         String    @default("Indique e Ganhe")
  active       Boolean   @default(false) // admin liga/desliga
  rewardAmount Decimal   @default(5) @db.Decimal(10, 2)
  maxReferrals Int       @default(0) // 0 = ilimitado
  startsAt     DateTime?
  endsAt       DateTime?
  termsUrl     String?   // URL dos termos e condições
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ===== Leads capturados no quiz / exit-intent / landing =====
//
// Funil: Landing → Quiz → captura email/WhatsApp → resultado personalizado
// → redireciona para /app → trial 14 dias → conversão vitalício
//
// Lead é diferente de User: Lead é anônimo (sem senha), só tem email/phone.
// Quando o Lead cria conta no /app, marcamos convertedAt e linkamos com User.

model Lead {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?
  name         String?
  // Respostas do quiz (JSON): { q1: "5-10", q2: "iFood", q3: "nao_ideia", q4: "gasolina" }
  quizAnswers  String?
  // Score calculado: quanto o entregador está "perdendo" (R$/semana estimado)
  resultScore  Int      @default(0)
  // Origem da captura: quiz | exit_intent | referral | landing_cta
  source       String   @default("quiz")
  // Código de quem indicou (se veio de link ?ref=MEUCORRE-ABC123)
  referrerCode String?
  // Quando virou usuário (fez registro no /app)
  convertedAt  DateTime?
  convertedUserId String? // ID do User se converteu
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([referrerCode])
  @@index([convertedAt])
  @@index([source, createdAt])
}

// ===== Release C — Central de Divulgação =====
//
// 5 modelos para gerenciar 450 postagens (90 dias × 5 posts/dia),
// assets visuais, canais oficiais e lembretes.
// Tudo protegido por feature flag admin_marketing_hub_enabled.
//
// Nenhuma tabela existente é modificada — apenas adição.

// Campanha editorial (ex: "Plano 90 Dias MeuCorre")
model Campaign {
  id          String   @id @default(cuid())
  name        String
  description String?
  objective   String?
  startAt     DateTime?
  endAt       DateTime?
  timezone    String   @default("America/Sao_Paulo")
  status      String   @default("draft") // draft | active | paused | completed | archived
  color       String   @default("#10b981")
  defaultUtm  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts       PromotionPost[]

  @@index([status])
  @@index([startAt, endAt])
}

// Postagem editorial (450 posts: 90 dias × 5/dia)
model PromotionPost {
  id              String   @id @default(cuid())
  campaignId      String
  editorialDay    Int      // 1-90 (dia editorial dentro da campanha)
  sequenceNumber  Int      // 1-5 (sequência do dia)
  publishAt       DateTime // horário programado (com timezone)
  timezone        String   @default("America/Sao_Paulo")
  platform        String   // Instagram | TikTok | Facebook | YouTube
  format          String?  // Reels | Carrossel | Short | Feed | Story
  pillar          String?  // Lucro real | Despesas | Comunidade | etc.
  title           String
  description     String   // legenda completa
  hashtags        String?  // #MeuCorre #EntregadorDeApp ...
  engagementText  String?  // texto curto para final da legenda
  cta             String?  // chamada para ação
  destinationUrl  String?  // link final (com UTM)
  altText         String?  // acessibilidade da imagem
  videoScript     String?  // roteiro para vídeo (se aplicável)
  durationSeconds Int?     // duração do vídeo (se aplicável)
  status          String   @default("pending") // pending | published | skipped | failed
  publishedAt     DateTime?
  notes           String?
  utmQuery        String?  // ?utm_source=...&utm_campaign=...
  assetId         String?  // referência ao PromotionAsset
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  asset           PromotionAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  reminders       PromotionReminder[]

  @@unique([campaignId, editorialDay, sequenceNumber, platform])
  @@index([campaignId, editorialDay])
  @@index([platform, status])
  @@index([publishAt])
  @@index([status])
}

// Asset visual (imagem, vídeo) vinculado a uma ou mais postagens
model PromotionAsset {
  id            String   @id @default(cuid())
  name          String   // nome do arquivo (ex: M01_D01_P01_Instagram_vendas_ig_feed_1.png)
  storageKey    String   // caminho no storage (ex: promotion/M01/M01_D01_P01_...png)
  publicUrl     String?  // URL pública (CDN, Vercel Blob, ou local /uploads/promotion/...)
  mimeType      String   @default("image/png")
  width         Int?
  height        Int?
  fileSize      Int?     // bytes
  altText       String?
  source        String?  // origem: kit_comercial | repositorio | upload_admin | importado
  baseAssetName String?  // nome do arquivo-base aprovado (ex: vendas_ig_feed_1.png)
  tags          String?  // tags separadas por vírgula
  hash          String?  // hash do conteúdo para deduplicação
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  posts         PromotionPost[]

  @@index([name])
  @@index([baseAssetName])
  @@index([hash])
}

// Canal oficial (Instagram, TikTok, YouTube, Facebook, Aplicação, Quiz)
model SocialChannel {
  id          String   @id @default(cuid())
  name        String   // Instagram | TikTok | YouTube | Facebook | Aplicação | Quiz
  platform    String   // instagram | tiktok | youtube | facebook | app | quiz
  profileUrl  String   // URL do perfil
  bannerUrl   String?
  promoTitle  String?
  promoText   String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([platform, active])
  @@index([sortOrder])
}

// Lembrete de postagem (Notification API + fallback)
model PromotionReminder {
  id            String   @id @default(cuid())
  postId        String
  remindAt      DateTime // quando disparar
  minutesBefore Int      @default(15) // minutos antes do publishAt
  channel       String   @default("browser") // browser | email | whatsapp
  status        String   @default("pending") // pending | sent | failed | canceled
  sentAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  post          PromotionPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([status, remindAt])
}

// ===== Release D — CRM Básico (Parceiros) =====
//
// 5 modelos para gerenciar parceiros B2B: empresas, contatos, oportunidades,
// atividades e log de auditoria. Tudo protegido por admin_partner_crm_enabled.
//
// Foco inicial: Recife/PE (decisão #1), serviços em geral do nicho (decisão #2),
// responsável: Clodoaldo Silva (decisão #3).
//
// Nenhuma tabela existente é modificada — apenas adição.

// Empresa parceira (oficina, loja de pneus, acessórios, alimentação, etc.)
model Partner {
  id              String   @id @default(cuid())
  // Identificação
  companyName     String
  tradeName       String?
  cnpj            String?  @unique
  category        String?  // oficina | pneus | acessorios | alimentacao | protecao | servicos | outros
  origin          String?  // manual | form | indicacao | importacao_csv | outbound
  // Localização
  city            String?
  state           String?
  address         String?
  website         String?
  // Canais
  phone           String?
  email           String?
  logoUrl         String?
  // Comercial
  assignedTo      String?  @default("Clodoaldo Silva") // responsável comercial
  priority        String   @default("media") // baixa | media | alta | urgente
  status          String   @default("active") // active | paused | archived | lost | disqualified
  stage           String   @default("novo_lead") // novo_lead | qualificando | contato_iniciado | descoberta | proposta_enviada | negociacao | aguardando_aprovacao | ativacao | ativo | renovacao | perdido | desqualificado
  // Qualificação (scores 0-100)
  relevanceScore  Int?     // relevância para o MeuCorre
  benefitScore    Int?     // benefício oferecido ao entregador
  reputationScore Int?     // reputação no mercado
  capacityScore   Int?     // capacidade de execução
  riskScore       Int?     // risco percebido
  // Tags livres (vírgula separada)
  tags            String?
  // Valores
  potentialValue  Decimal? @db.Decimal(10, 2) // valor potencial mensal
  notes           String?
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contacts        PartnerContact[]
  opportunities   Opportunity[]
  proposals       Proposal[]
  campaigns       PartnerCampaign[]
  activities      PartnerActivity[]
  logs            PartnerLog[]
  outboundLogs    OutboundLog[]

  @@index([city, state])
  @@index([category])
  @@index([stage])
  @@index([status])
  @@index([assignedTo])
  @@index([priority])
}

// Contato de uma empresa (pessoa)
model PartnerContact {
  id          String   @id @default(cuid())
  partnerId   String
  name        String
  role        String?  // cargo: gerente | proprietario | marketing | etc.
  email       String?
  phone       String?
  isPrimary   Boolean  @default(false)
  optOut      Boolean  @default(false) // se true, nunca selecionar para outbound
  // Rede social
  linkedinUrl String?
  // Notas específicas do contato
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  outboundLogs OutboundLog[]

  @@index([partnerId])
  @@index([email])
  @@index([phone])
  @@index([optOut])
}

// Oportunidade comercial (negócio no pipeline)
model Opportunity {
  id              String   @id @default(cuid())
  partnerId       String
  // Contato principal da oportunidade (opcional)
  contactId       String?
  // Descrição
  title           String
  description     String?
  // Estágio (espelha Partner.stage mas permite múltiplas oportunidades por empresa)
  stage           String   @default("novo_lead")
  // Valor
  potentialValue  Decimal? @db.Decimal(10, 2)
  // Datas
  expectedCloseAt DateTime?
  wonAt           DateTime?
  lostAt          DateTime?
  lostReason      String?
  // Modelos de cobrança (decisão #7): por campanha, por lead, ou ambos
  billingModel    String?  // campaign | lead | both
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  partner         Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  contact         PartnerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  activities      PartnerActivity[]
  proposals       Proposal[]

  @@index([partnerId])
  @@index([stage])
  @@index([expectedCloseAt])
}

// Atividade (ligação, email, reunião, follow-up, anotação)
model PartnerActivity {
  id          String   @id @default(cuid())
  partnerId   String
  opportunityId String?
  // Tipo
  type        String   // call | email | whatsapp | meeting | follow_up | note | document
  // Conteúdo
  title       String
  description String?
  // Agendamento
  scheduledAt DateTime?
  completedAt DateTime?
  // Status
  status      String   @default("pending") // pending | done | canceled
  // Responsável
  assignedTo  String?  @default("Clodoaldo Silva")
  // Metadata (JSON string)
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([opportunityId])
  @@index([status, scheduledAt])
  @@index([assignedTo])
}

// Log de auditoria — todas as alterações em Partner e relacionados
model PartnerLog {
  id          String   @id @default(cuid())
  partnerId   String
  // Ação: created | updated | deleted | stage_changed | contact_added | etc.
  action      String
  // Detalhes (JSON string): { field, oldValue, newValue, ... }
  details     String?
  // Quem executou
  adminId     String?
  adminEmail  String?
  ipAddress   String?
  // Quando
  createdAt   DateTime @default(now())

  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
  @@index([action])
}

// ===== Release E — Propostas e Materiais =====
//
// 2 modelos para gerenciar propostas comerciais (com versões e validade)
// e biblioteca de materiais (media kit, cases, contratos).
// Usa feature flag admin_partner_crm_enabled (já existente).
//
// Modelo duplo de cobrança (decisão #7): campaign | lead | both
// Nenhuma tabela existente é modificada — apenas adição.

// Proposta comercial — vinculada a uma Opportunity (negócio no pipeline)
model Proposal {
  id              String   @id @default(cuid())
  partnerId       String
  opportunityId   String?
  // Identificação
  number          String   @unique // ex: PROP-2026-001
  title           String
  // Conteúdo (Markdown)
  body            String   // corpo da proposta
  summary         String?  // resumo executivo
  // Modelo de cobrança (decisão #7)
  billingModel    String?  // campaign | lead | both
  campaignPrice   Decimal? @db.Decimal(10, 2) // preço por campanha (mensal)
  leadPrice       Decimal? @db.Decimal(10, 2) // preço por lead
  // Vigência
  validUntil      DateTime? // prazo de validade
  sentAt          DateTime?
  // Aprovação humana
  status          String   @default("draft") // draft | sent | approved | rejected | expired | canceled
  approvedAt      DateTime?
  approvedBy      String?
  approvedByEmail String?
  rejectedAt      DateTime?
  rejectedReason  String?
  // Versão (incremental)
  version         Int      @default(1)
  parentProposalId String? // se for revisão, aponta para a proposta pai
  // Link público (gerado quando enviada)
  publicToken     String?  @unique // token para acesso público sem auth
  // Metadata
  notes           String?
  createdBy       String?
  createdByEmail  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  partner         Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  campaigns       PartnerCampaign[]

  @@index([partnerId])
  @@index([opportunityId])
  @@index([status])
  @@index([validUntil])
  @@index([publicToken])
}

// Asset comercial (media kit, case, contrato, apresentação)
model CommercialAsset {
  id          String   @id @default(cuid())
  // Tipo
  type        String   // media_kit | case | contract | presentation | one_pager | pricing_table | video | other
  // Identificação
  name        String
  description String?
  // Arquivo
  storageKey  String
  publicUrl   String?
  mimeType    String
  fileSize    Int?     // bytes
  // Versão
  version     String?  // ex: "v1.0", "2026-08"
  // Tags e categoria
  tags        String?
  // Status
  active      Boolean  @default(true)
  // Metadata
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, active])
  @@index([name])
  @@index([tags])
}

// ===== Release F — Campanhas de Parceiros =====
//
// 1 modelo para conectar venda comercial à operação do app.
// PartnerCampaign é uma camada ADICIONAL — NÃO modifica Ad/Offer existentes.
// Anúncios atuais continuam funcionando intactos.
//
// Modelo duplo de cobrança (decisão #7): campaign | lead | both
// Feature flag: partner_campaigns_enabled
// Nenhuma tabela existente é modificada — apenas adição.

// Campanha de parceiro — oferta promovida no app + redes sociais
model PartnerCampaign {
  id              String   @id @default(cuid())
  partnerId       String
  proposalId      String?  // proposta que originou (opcional)
  // Identificação
  name            String
  description     String?
  // Oferta
  offerTitle      String   // título exibido no app
  offerDescription String  // descrição exibida
  offerCta        String   @default("Aproveitar") // texto do botão
  offerUrl        String   // URL de destino (com UTM)
  couponCode      String?  // cupom de desconto (ex: MEUCORRE10)
  discountText    String?  // texto do desconto (ex: "10% OFF" ou "Frete grátis")
  // Assets
  imageUrl        String?  // imagem da campanha (pode usar CommercialAsset)
  videoUrl        String?  // vídeo promocional
  // Segmentação
  category        String   @default("servicos") // espelha Offer.category
  city            String?  // cidade-alvo (null = nacional)
  state           String?  // estado-alvo (null = nacional)
  proOnly         Boolean  @default(false) // só PRO vê?
  // Vigência
  startsAt        DateTime @default(now())
  endsAt          DateTime? // null = sem expiração
  // Modelo de cobrança (decisão #7)
  billingModel    String   @default("campaign") // campaign | lead | both
  campaignPrice   Decimal? @db.Decimal(10, 2) // preço mensal da campanha
  leadPrice       Decimal? @db.Decimal(10, 2) // preço por lead gerado
  // Status
  status          String   @default("draft") // draft | pending_approval | approved | published | paused | expired | rejected | canceled
  approvedAt      DateTime?
  approvedBy      String?
  approvedByEmail String?
  publishedAt     DateTime?
  pausedAt        DateTime?
  rejectedReason  String?
  // Métricas (counters incrementais)
  views           Int      @default(0)
  clicks          Int      @default(0)
  leads           Int      @default(0) // cliques que geraram cadastro
  redemptions     Int      @default(0) // cupons resgatados
  // Denúncia
  reportsCount    Int      @default(0)
  reportedAt      DateTime?
  reportedReason  String?
  // Metadata
  utmSource       String?  @default("parceiro")
  utmMedium       String?  @default("app")
  utmCampaign     String?  // campaign name slug
  notes           String?
  createdBy       String?
  createdByEmail  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  partner         Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  proposal        Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([status])
  @@index([category])
  @@index([city, state])
  @@index([startsAt, endsAt])
  @@index([proOnly])
}

// ===== Release G — Outbound Supervisionado =====
//
// 2 modelos para prospecção B2B supervisionada.
// PRINCÍPIO CRÍTICO: o sistema prepara; o administrador executa.
// Nenhum envio automático — sempre supervisionado.
//
// Feature flags:
//   - partner_outbound_preview_enabled (ON após validação interna)
//   - partner_outbound_send_enabled (OFF por padrão — só ativa com revisão humana)
//
// Opt-out permanente: contato com optOut=true NUNCA é selecionado.
// Nenhuma tabela existente é modificada — apenas adição.

// Template de mensagem outbound (versionado)
model OutboundTemplate {
  id            String   @id @default(cuid())
  // Identificação
  name          String   // ex: "Oficina local — primeiro contato"
  channel       String   // email | whatsapp | linkedin | phone
  segment       String?  // categoria + região (ex: "oficina-recife")
  objective     String   // permission | discovery | proposal | follow_up | renewal
  // Conteúdo
  subject       String?  // assunto (só para email)
  body          String   // template com variáveis: {NOME}, {EMPRESA}, {CIDADE}, {CATEGORIA}, {MOTIVO}
  cta           String?  // chamada para ação (curta)
  optOutText    String?  // texto de opt-out (ex: "Responda PARE para não receber mais")
  // Variáveis suportadas (documentadas no campo)
  variables     String?  // lista de variáveis: "NOME,EMPRESA,CIDADE,CATEGORIA,MOTIVO"
  // Status
  status        String   @default("draft") // draft | approved | paused | archived
  // Versão
  version       Int      @default(1)
  parentTemplateId String? // se for revisão, aponta para o template pai
  // Metadata
  notes         String?
  createdBy     String?
  createdByEmail String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  logs          OutboundLog[]

  @@index([channel, status])
  @@index([objective])
  @@index([status])
  @@index([parentTemplateId])
}

// Log de envio outbound (uma mensagem por contato)
model OutboundLog {
  id            String   @id @default(cuid())
  // Relacionamentos
  partnerId     String
  contactId     String
  templateId    String?
  // Mensagem
  channel       String   // email | whatsapp | linkedin | phone
  // Preview expandido (variáveis substituídas)
  renderedSubject String?
  renderedBody  String   // conteúdo final após substituição de variáveis
  renderedCta   String?
  // Status (13 valores conforme especificação)
  status        String   @default("preparado") // preparado | aguardando_aprovacao | enviado | respondeu | interessado | reuniao_marcada | proposta_enviada | negociacao | ganho | ativo | opt_out | perdido | erro
  // Classificação da resposta (se houve)
  responseText  String?  // texto da resposta recebida
  responseClassification String? // permission_to_send | interessado | pricing_question | meeting_ready | opt_out | nurture_future | ambiguous | risk
  responseClassifiedAt DateTime?
  responseClassifiedBy String?
  responseClassifiedByEmail String?
  responseClassifiedByMethod String? // manual | ai
  // Razão de perda (se status=perdido)
  lostReason    String?
  // Follow-up
  followUpAt    DateTime? // quando retomar contato
  followUpNotes String?
  // Envio manual
  sentAt        DateTime?
  sentBy        String?
  sentByEmail   String?
  sentManuallyAt DateTime? // quando o admin registrou o envio no sistema
  // Aprovação (dry-run aprovado)
  approvedAt    DateTime?
  approvedBy    String?
  approvedByEmail String?
  // Erro
  errorMessage  String?
  // Metadata
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  partner       Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  contact       PartnerContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  template      OutboundTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([contactId])
  @@index([templateId])
  @@index([status])
  @@index([channel, status])
  @@index([followUpAt])
  @@index([responseClassification])
}

// ===== Release I — Recursos Avançados =====
//
// Modelos para:
// 1. MeuCorre Equipes (Team, TeamMember, TeamInvite) — B2B MVP
// 2. Portal do Parceiro (PartnerPortalToken) — visão restrita
// 3. Radar do Prejuízo (RadarAlert) — alertas explicáveis no app
// 4. MeuCorre Score (ScoreSnapshot) — consistência, não julga
// 5. Desafio de 7 dias (ChallengeParticipant) — engajamento
//
// Tudo protegido por feature flags.
// Nenhuma tabela existente é modificada — apenas adição.

// ===== Equipes B2B =====
// Permite que empresas organizem seus entregadores em times.
// Privacidade: cada membro só vê dados agregados do próprio time.
// Admin gerencia times; membros não veem outros times.

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  // Empresa/organização responsável
  companyName String?
  cnpj        String?
  // Contato do gestor
  managerName String?
  managerEmail String?
  managerPhone String?
  // Configurações
  active      Boolean  @default(true)
  maxMembers  Int      @default(50) // limite de membros
  // Metadata
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     TeamMember[]
  invites     TeamInvite[]

  @@index([active])
  @@index([companyName])
}

model TeamMember {
  id          String   @id @default(cuid())
  teamId      String
  userId      String?  // link com User quando aceita convite
  // Dados do membro (preenchidos no convite, antes de linkar com User)
  name        String
  email       String
  phone       String?
  // Role no time
  role        String   @default("member") // owner | admin | member
  // Status
  status      String   @default("active") // active | suspended | removed
  joinedAt    DateTime @default(now())
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
  @@index([teamId, status])
  @@index([userId])
  @@index([email])
}

model TeamInvite {
  id          String   @id @default(cuid())
  teamId      String
  // Dados do convidado
  email       String
  name        String?
  phone       String?
  // Token de aceite (único, expira em 7 dias)
  token       String   @unique
  // Role que terá ao aceitar
  role        String   @default("member")
  // Status
  status      String   @default("pending") // pending | accepted | rejected | expired
  invitedBy   String?
  invitedAt   DateTime @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?
  acceptedUserId String? // User que aceitou
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, status])
  @@index([email])
  @@index([token])
  @@index([expiresAt])
}

// ===== Portal do Parceiro =====
// Token de acesso para parceiro ver suas campanhas e métricas.
// Sem auth admin — usa token único por parceiro.

model PartnerPortalToken {
  id          String   @id @default(cuid())
  partnerId   String
  token       String   @unique
  // Permissões
  canViewCampaigns Boolean @default(true)
  canViewMetrics   Boolean @default(true)
  canViewProposals Boolean @default(false)
  // Vigência
  expiresAt   DateTime? // null = sem expiração
  lastUsedAt  DateTime?
  // Status
  active      Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([partnerId])
  @@index([token])
  @@index([active])
}

// ===== Radar do Prejuízo =====
// Alertas explicáveis no app do entregador.
// Cada alerta tem: gatilho, explicação, ação sugerida, e pode ser desligado.

model RadarAlert {
  id          String   @id @default(cuid())
  userId      String   // entregador
  // Tipo de alerta
  type        String   // despesa_alta | lucro_baixo | sem_corrida_dias | despesa_recorrente | meta_atrasada | gastos_vs_ganhos
  // Conteúdo explicável
  title       String
  message     String   // explicação em linguagem natural
  // Dados que dispararam o alerta (JSON)
  triggerData String?
  // Ação sugerida
  suggestedAction String?
  // Severidade
  severity    String   @default("medium") // low | medium | high
  // Status
  status      String   @default("active") // active | dismissed | resolved
  dismissedAt DateTime?
  dismissedReason String?
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
  @@index([type, status])
  @@index([severity, status])
  @@index([createdAt])
}

// ===== MeuCorre Score =====
// Score de consistência do entregador (0-100).
// NÃO JULGA — mostra evolução. Não compara com outros.
// Fatores: regularidade de lançamentos, consistência de lucro, acompanhamento de metas.

model ScoreSnapshot {
  id          String   @id @default(cuid())
  userId      String
  // Score total (0-100)
  score       Int
  // Fatores (cada um 0-100, ponderados)
  regularityScore    Int // regularidade de lançamentos (corridas/despesas)
  consistencyScore   Int // consistência de lucro positivo
  goalAdherenceScore Int // acompanhamento de metas
  // Detalhes (JSON: { factor, value, weight, contribution })
  details     String?
  // Período de referência
  periodStart DateTime
  periodEnd   DateTime
  // Metadata
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([periodStart, periodEnd])
}

// ===== Desafio de 7 dias =====
// Engajamento: entregador se compromete com hábitos por 7 dias.
// Cada dia tem uma tarefa. Sistema rastreia progresso.

model ChallengeParticipant {
  id          String   @id @default(cuid())
  userId      String
  // Status do desafio
  status      String   @default("active") // active | completed | abandoned | expired
  // Progresso (7 dias)
  currentDay  Int      @default(1) // 1-7
  // Tarefas concluídas (JSON: { day: 1, completed: true, completedAt: "..." })
  tasksJson   String   @default("[]")
  // Recompensa
  rewardClaimed Boolean @default(false)
  rewardClaimedAt DateTime?
  // Vigência
  startedAt   DateTime @default(now())
  completedAt DateTime?
  expiresAt   DateTime  // 7 dias + tolerância
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
  @@index([status, expiresAt])
}
