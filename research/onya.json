rity.ms/tag/\"+i;\n        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);\n      })(window, document, \"clarity\", \"script\", \"xanh0u0jok\");\n    </script>\n\n    <!-- Meta Pixel (Facebook/Instagram Ads). Só o ID (público). PageView automático.\n         \"Lead\" (conversão otimizada) dispara no CADASTRO real como pro (createOrganization).\n         O quiz /quiz-nutri dispara só um evento custom (QuizContact) ao capturar o contato. -->\n    <script>\n      !function(f,b,e,v,n,t,s)\n      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?\n      n.callMethod.apply(n,arguments):n.queue.push(arguments)};\n      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';\n      n.queue=[];t=b.createElement(e);t.async=!0;\n      t.src=v;s=b.getElementsByTagName(e)[0];\n      s.parentNode.insertBefore(t,s)}(window, document,'script',\n      'https://connect.facebook.net/en_US/fbevents.js');\n      fbq('init', '4314285255501299');\n      fbq('track', 'PageView');\n    </script>\n\n    <!-- Dados estruturados (Schema.org) — extraíveis por IA -->\n    <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@graph\": [\n        {\n          \"@type\": \"Organization\",\n          \"@id\": \"https://onya.life/#organization\",\n          \"name\": \"Onya\",\n          \"url\": \"https://onya.life/\",\n          \"logo\": \"https://onya.life/icons/logo-onya.png\",\n          \"description\": \"App de saúde brasileiro para acompanhamento de alimentação, glicemia e exames, conectando pacientes a nutricionistas e endocrinologistas.\",\n          \"areaServed\": \"BR\"\n        },\n        {\n          \"@type\": \"SoftwareApplication\",\n          \"name\": \"Onya\",\n          \"operatingSystem\": \"Web, iOS, Android (PWA)\",\n          \"applicationCategory\": \"HealthApplication\",\n          \"url\": \"https://onya.life/\",\n          \"inLanguage\": \"pt-BR\",\n          \"description\": \"Onya registra alimentação, glicemia, peso, sono e exames e conecta o paciente ao seu nutricionista ou endocrinologista para acompanhamento entre as consultas. Para diabéticos: tempo no alvo, hemoglobina glicada (A1c) estimada e cofre de exames com OCR. Análise de carboidratos pela Tabela TACO.\",\n          \"featureList\": [\n            \"Registro de glicemia com tempo no alvo e A1c estimada (GMI)\",\n            \"Análise de alimentação por foto ou texto com carboidratos pela Tabela TACO\",\n            \"Cofre de exames com leitura automática (OCR) e evolução no tempo\",\n            \"Painel para o profissional acompanhar o paciente entre consultas\",\n            \"Registro de peso, sono, humor e medicação\"\n          ],\n          \"offers\": [\n            { \"@type\": \"Offer\", \"name\": \"Grátis\", \"price\": \"0\", \"priceCurrency\": \"BRL\" },\n            { \"@type\": \"Offer\", \"name\": \"Essencial\", \"price\": \"39.90\", \"priceCurrency\": \"BRL\" },\n            { \"@type\": \"Offer\", \"name\": \"Completo\", \"price\": \"49.90\", \"priceCurrency\": \"BRL\" },\n            { \"@type\": \"Offer\", \"name\": \"Profissional\", \"price\": \"297.00\", \"priceCurrency\": \"BRL\" }\n          ]\n        },\n        {\n          \"@type\": \"FAQPage\",\n          \"mainEntity\": [\n            {\n              \"@type\": \"Question\",\n              \"name\": \"O que é o Onya?\",\n              \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Onya é um app de saúde brasileiro que registra alimentação, glicemia, peso, sono e exames, e conecta o paciente ao seu nutricionista ou endocrinologista para acompanhamento entre as consultas.\" }\n            },\n            {\n              \"@type\": \"Question\",\n              \"name\": \"Para que serve o Onya para nutricionistas e endocrinologistas?\",\n              \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Permite acompanhar os pacientes (especialmente diabéticos) entre as consultas com um painel de evolução — tempo no alvo glicêmico, hemoglobina glicada estimada e alimentação — para sustentar o tratamento e reduzir o abandono.\" }\n            },\n            {\n              \"@type\": \"Question\",\n              \"name\": \"O Onya serve para controle de diabetes?\",\n              \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Sim. Registra glicemia, calcula tempo no alvo (70 a 180 mg/dL) e a hemoglobina glicada (A1c) estimada, organiza os exames num cofre com a HbA1c ao longo do tempo e cruza com a alimentação.\" }\n            },\n            {\n              \"@type\": \"Question\",\n              \"name\": \"Como o Onya analisa a alimentação?\",\n              \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"A partir de uma foto ou descrição em texto, o Onya identifica os alimentos e calcula os carboidratos e calorias usando a Tabela TACO (Tabela Brasileira de Composição de Alimentos, da UNICAMP).\" }\n            },\n            {\n              \"@type\": \"Question\",\n              \"name\": \"Quanto custa o Onya?\",\n              \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Tem plano gratuito para registro manual e planos pagos a partir de R$39,90 por mês. Para profissionais (nutricionistas e endocrinologistas), os planos começam em R$297 por mês conforme o número de pacientes.\" }\n            },\n            {\n              \"@type\": \"Question\",\n              \"name\": \"O Onya é seguro e está de acordo com a LGPD?\",\n              \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Sim. Os dados são criptografados e o Onya é compatível com a LGPD. O dado de saúde pertence ao paciente e fica acessível ao profissional que o acompanha.\" }\n            }\n          ]\n        }\n      ]\n    }\n    </script>\n    <script type=\"module\" crossorigin=\"\" src=\"/assets/index.ddcvbI5T.js\"></script>\n    <link rel=\"modulepreload\" crossorigin=\"\" href=\"/assets/ocr.C1aGq8bp.js\">\n    <link rel=\"modulepreload\" crossorig